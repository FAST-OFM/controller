+static void
+scanner_sync_apply_output_state(struct scanner_sync *ss, uint8_t output_mask,
+                                uint8_t output_values)
+{
+    uint8_t bit;
+    for (bit = 1; bit <= SS_OUTPUT_HQ_XVS_SYNC; bit <<= 1) {
+        if (!(output_mask & bit))
+            continue;
+        uint8_t output = scanner_sync_logical_output_index(bit);
+        if (output < SSO_COUNT)
+            scanner_sync_write_output(ss, output, !!(output_values & bit));
+    }
+    ss->latched_outputs = (ss->latched_outputs & ~output_mask)
+        | (output_values & output_mask);
