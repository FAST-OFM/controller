+static uint_fast8_t
+scanner_sync_timed_output_sequence_event(struct scanner_sync *ss)
+{
+    struct scanner_sync_timed_output_step *step;
+    if (!ss->sequence_active || ss->sequence_step_index >= ss->sequence_step_count) {
+        scanner_sync_emit_timed_sequence_status(
+            ss->oid, ss, SS_STATUS_FAULT, SS_REASON_FAULT);
+        scanner_sync_timed_sequence_fault(ss);
+        return SF_DONE;
+    }
+    step = &ss->sequence_steps[ss->sequence_step_index];
+
+    // A pause step has output_mask=0 and only advances MCU-local time.
+    if (step->output_mask)
+        scanner_sync_apply_output_state(ss, step->output_mask, step->output_values);
