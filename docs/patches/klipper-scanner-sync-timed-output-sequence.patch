+static uint32_t
+scanner_sync_crc32(const uint8_t *data, uint16_t len)
+{
+    uint32_t crc = 0xffffffff;
+    uint16_t i;
+    for (i = 0; i < len; i++) {
+        crc ^= data[i];
+        uint8_t bit;
+        for (bit = 0; bit < 8; bit++) {
+            uint32_t mask = -(crc & 1);
+            crc = (crc >> 1) ^ (0xedb88320 & mask);
+        }
+    }
