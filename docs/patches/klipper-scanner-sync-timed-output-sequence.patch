+void
+command_scanner_sync_run_timed_output_sequence(uint32_t *args)
+{
+    uint8_t oid = args[0];
+    uint32_t seq = args[1];
+    uint32_t stripe_id = args[2];
+    struct scanner_sync *ss = scanner_sync_oid_lookup(oid);
+    uint8_t mode = args[4], start_condition = args[5];
+    uint32_t repeat_count = args[7];
+    uint8_t safe_output_mask = args[10], safe_output_values = args[11];
+    uint8_t idle_output_mask = args[12], idle_output_values = args[13];
+    uint8_t step_count = args[14];
+    uint32_t steps_crc32 = args[15];
+    uint16_t encoded_steps_len = args[16];
+    const uint8_t *encoded_steps = (const void *)args[17];
+
+    if (!ss->hardware_outputs_enabled || !scanner_sync_timed_outputs_ready(ss)
+        || ss->timer_active || mode != SS_MODE_DIAGNOSTIC_IMMEDIATE
+        || start_condition != SS_START_IMMEDIATE || args[6] != (uint32_t)-1
+        || step_count == 0 || step_count > SS_MAX_STEPS
+        || encoded_steps_len != step_count * SS_STEP_BYTES
+        || (safe_output_mask & ~SS_KNOWN_OUTPUT_MASK)
+        || (safe_output_values & ~safe_output_mask)
+        || (idle_output_mask & ~SS_KNOWN_OUTPUT_MASK)
+        || (idle_output_values & ~idle_output_mask)
+        || scanner_sync_crc32(encoded_steps, encoded_steps_len) != steps_crc32) {
+        scanner_sync_timed_sequence_fault(ss);
+        scanner_sync_emit_timed_sequence_rejected(oid, seq, stripe_id, args[3]);
+        sendf("scanner_sync_z_rejected oid=%c seq=%u reason=%c status=%c",
+              oid, seq, 0, 1);
+        return;
+    }
+
+    uint8_t i;
+    for (i = 0; i < step_count; i++) {
+        if (!scanner_sync_decode_timed_output_step(
+                &ss->sequence_steps[i], encoded_steps + i * SS_STEP_BYTES)) {
+            scanner_sync_timed_sequence_fault(ss);
+            scanner_sync_emit_timed_sequence_rejected(oid, seq, stripe_id, args[3]);
+            sendf("scanner_sync_z_rejected oid=%c seq=%u reason=%c status=%c",
+                  oid, seq, 0, 1);
+            return;
+        }
+    }
+
+    ss->seq = seq;
+    ss->stripe_id = stripe_id;
+    ss->sequence_id = args[3];
+    ss->repeat_count = repeat_count;
+    ss->repeat_index = 0;
+    ss->sequence_step_count = step_count;
