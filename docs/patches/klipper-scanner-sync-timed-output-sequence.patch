+                ss->oid, ss, SS_STATUS_COMPLETED, SS_REASON_FINITE_COMPLETION);
+            ss->sequence_active = 0;
+            ss->active = 0;
+            ss->timer_active = 0;
+            return SF_DONE;
+        }
+    }
+
+    ss->timer.waketime += step->delay_ticks;
+    return SF_RESCHEDULE;
+}
