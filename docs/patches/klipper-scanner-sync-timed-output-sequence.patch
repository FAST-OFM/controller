+    if (step->event_flags & SS_EVENT_FRAME) {
+        scanner_sync_emit_timed_sequence_frame_event(
+            ss->oid, ss, step->event_flags);
+        ss->emitted_sequence_frames++;
+    }
+
+    ss->sequence_step_index++;
+    if (ss->sequence_step_index >= ss->sequence_step_count) {
+        ss->sequence_step_index = 0;
+        ss->repeat_index++;
+        // repeat_count=0 repeats until explicit stop, shutdown or fault.
+        if (ss->repeat_count && ss->repeat_index >= ss->repeat_count) {
+            scanner_sync_apply_output_state(ss, ss->idle_output_mask,
+                                            ss->idle_output_values);
