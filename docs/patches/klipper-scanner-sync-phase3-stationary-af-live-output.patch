diff --git a/src/scanner_sync.c b/src/scanner_sync.c
new file mode 100644
index 000000000..425e5065a
--- /dev/null
+++ b/src/scanner_sync.c
@@ -0,0 +1,373 @@
+// Scanner synchronization bench timing support.
+//
+// Phase 3 stationary AF bench path. This file supports a no-motion diagnostic
+// sequence for tuning LED/XVS timing. It does not command steppers or homing.
+
+#include "basecmd.h" // oid_alloc
+#include "board/gpio.h" // gpio_out
+#include "board/misc.h" // timer_from_us, timer_read_time
+#include "command.h" // DECL_COMMAND
+#include "sched.h" // DECL_SHUTDOWN, sched_add_timer, sched_del_timer
+
+void command_config_scanner_sync(uint32_t *args);
+
+enum {
+    SSO_TRIGGER = 0,
+    SSO_LED_WHITE = 1,
+    SSO_LED_RED = 2,
+    SSO_LED_GREEN = 3,
+    SSO_COUNT = 4,
+};
+
+enum {
+    SSP_IDLE = 0,
+    SSP_PREPARE_AF = 1,
+    SSP_XVS_HIGH = 2,
+    SSP_XVS_LOW = 3,
+    SSP_FRAME_END = 4,
+};
+
+struct scanner_sync_output {
+    struct gpio_out pin;
+    uint8_t configured, active_high;
+};
+
+struct scanner_sync {
+    struct timer timer;
+    struct scanner_sync_output outputs[SSO_COUNT];
+    uint32_t next_frame_id, emitted_frame_count, expected_frame_count;
+    uint32_t stripe_id, frame_period_ticks, settle_ticks;
+    uint32_t xvs_pulse_ticks, exposure_hold_ticks;
+    uint32_t next_frame_clock, event_position_count;
+    uint32_t seq;
+    uint8_t oid, protocol_version, active, hardware_outputs_enabled;
+    uint8_t timer_active, phase, pattern_id, position_axis;
+};
+
+static uint_fast8_t scanner_sync_timer_event(struct timer *timer);
+
+static struct scanner_sync *
+scanner_sync_oid_lookup(uint8_t oid)
+{
+    return oid_lookup(oid, command_config_scanner_sync);
+}
+
+static uint8_t
+scanner_sync_output_level(struct scanner_sync *ss, uint8_t output, uint8_t active)
+{
+    uint8_t active_high = ss->outputs[output].active_high;
+    return active ? active_high : !active_high;
+}
+
+static void
+scanner_sync_write_output(struct scanner_sync *ss, uint8_t output, uint8_t active)
+{
+    if (!ss->outputs[output].configured)
+        return;
+    gpio_out_write(ss->outputs[output].pin,
+                   scanner_sync_output_level(ss, output, active));
+}
+
+static void
+scanner_sync_outputs_safe(struct scanner_sync *ss)
+{
+    scanner_sync_write_output(ss, SSO_TRIGGER, 0);
+    scanner_sync_write_output(ss, SSO_LED_RED, 0);
+    scanner_sync_write_output(ss, SSO_LED_GREEN, 0);
+    scanner_sync_write_output(ss, SSO_LED_WHITE, 0);
+}
+
+static uint8_t
+scanner_sync_outputs_ready(struct scanner_sync *ss)
+{
+    return ss->outputs[SSO_TRIGGER].configured
+        && ss->outputs[SSO_LED_RED].configured
+        && ss->outputs[SSO_LED_GREEN].configured
+        && ss->outputs[SSO_LED_WHITE].configured;
+}
+
+static uint32_t
+scanner_sync_clock_to_us(uint32_t clock)
+{
+    uint32_t ticks_per_us = timer_from_us(1);
+    if (!ticks_per_us)
+        return clock;
+    return clock / ticks_per_us;
+}
+
+static void
+scanner_sync_emit_frame_event(uint8_t oid, struct scanner_sync *ss)
+{
+    int32_t event_position = ss->event_position_count;
+    int32_t x_count = ss->position_axis == 'X' ? event_position : 0;
+    int32_t y_count = ss->position_axis == 'Y' ? event_position : 0;
+    sendf("scanner_sync_frame_event oid=%c frame_id=%u stripe_id=%u"
+          " stripe_frame_index=%u pattern_id=%u position_axis=%c"
+          " event_position=%i x_count=%i y_count=%i z_count=%i"
+          " mcu_time_us=%u status=%c flags=%u",
+          oid, ss->next_frame_id, ss->stripe_id, ss->emitted_frame_count,
+          ss->pattern_id, ss->position_axis, event_position, x_count, y_count,
+          0, scanner_sync_clock_to_us(ss->next_frame_clock), 0, 0);
+    ss->next_frame_id++;
+    ss->emitted_frame_count++;
+}
+
+static void
+scanner_sync_emit_terminal(uint8_t oid, struct scanner_sync *ss, uint8_t reason)
+{
+    int32_t last_frame_id = -1;
+    if (ss->emitted_frame_count)
+        last_frame_id = ss->next_frame_id - 1;
+    sendf("scanner_sync_scheduler_terminal oid=%c stripe_id=%u status=%c"
+          " reason=%c emitted_frame_count=%u expected_frame_count=%u"
+          " last_frame_id=%i next_frame_id=%u next_stripe_frame_index=%u"
+          " mcu_time_us=%u",
+          oid, ss->stripe_id, 0, reason, ss->emitted_frame_count,
+          ss->expected_frame_count, last_frame_id, ss->next_frame_id,
+          ss->emitted_frame_count, scanner_sync_clock_to_us(timer_read_time()));
+}
+
+static void
+scanner_sync_schedule(struct scanner_sync *ss, uint8_t phase, uint32_t waketime)
+{
+    ss->phase = phase;
+    ss->timer.func = scanner_sync_timer_event;
+    ss->timer.waketime = waketime;
+    ss->timer_active = 1;
+    sched_add_timer(&ss->timer);
+}
+
+static uint_fast8_t
+scanner_sync_prepare_af_window(struct scanner_sync *ss)
+{
+    scanner_sync_write_output(ss, SSO_TRIGGER, 0);
+    scanner_sync_write_output(ss, SSO_LED_WHITE, 0);
+    scanner_sync_write_output(ss, SSO_LED_RED, 1);
+    scanner_sync_write_output(ss, SSO_LED_GREEN, 1);
+    ss->phase = SSP_XVS_HIGH;
+    ss->timer.waketime = ss->next_frame_clock;
+    return SF_RESCHEDULE;
+}
+
+static uint_fast8_t
+scanner_sync_timer_event(struct timer *timer)
+{
+    struct scanner_sync *ss = container_of(timer, struct scanner_sync, timer);
+    switch (ss->phase) {
+    case SSP_PREPARE_AF:
+        return scanner_sync_prepare_af_window(ss);
+    case SSP_XVS_HIGH:
+        scanner_sync_write_output(ss, SSO_TRIGGER, 1);
+        scanner_sync_emit_frame_event(ss->oid, ss);
+        ss->phase = SSP_XVS_LOW;
+        ss->timer.waketime = ss->next_frame_clock + ss->xvs_pulse_ticks;
+        return SF_RESCHEDULE;
+    case SSP_XVS_LOW:
+        scanner_sync_write_output(ss, SSO_TRIGGER, 0);
+        ss->phase = SSP_FRAME_END;
+        ss->timer.waketime = ss->next_frame_clock + ss->exposure_hold_ticks;
+        return SF_RESCHEDULE;
+    case SSP_FRAME_END:
+        scanner_sync_write_output(ss, SSO_LED_RED, 0);
+        scanner_sync_write_output(ss, SSO_LED_GREEN, 0);
+        scanner_sync_write_output(ss, SSO_LED_WHITE, 1);
+        if (ss->emitted_frame_count >= ss->expected_frame_count) {
+            ss->phase = SSP_IDLE;
+            ss->timer_active = 0;
+            ss->active = 0;
+            return SF_DONE;
+        }
+        ss->next_frame_clock += ss->frame_period_ticks;
+        ss->phase = SSP_PREPARE_AF;
+        ss->timer.waketime = ss->next_frame_clock - ss->settle_ticks;
+        return SF_RESCHEDULE;
+    }
+    ss->timer_active = 0;
+    return SF_DONE;
+}
+
+void
+command_config_scanner_sync(uint32_t *args)
+{
+    struct scanner_sync *ss = oid_alloc(
+        args[0], command_config_scanner_sync, sizeof(*ss));
+    ss->oid = args[0];
+    ss->protocol_version = args[1];
+    ss->hardware_outputs_enabled = args[2];
+    ss->position_axis = 'X';
+}
+DECL_COMMAND(command_config_scanner_sync,
+             "config_scanner_sync oid=%c protocol_version=%c"
+             " hardware_outputs_enabled=%c");
+
+void
+command_config_scanner_sync_output(uint32_t *args)
+{
+    struct scanner_sync *ss = scanner_sync_oid_lookup(args[0]);
+    uint8_t output = args[1];
+    if (output >= SSO_COUNT)
+        return;
+    uint8_t active_high = !!args[3];
+    ss->outputs[output].pin = gpio_out_setup(args[2], !active_high);
+    ss->outputs[output].configured = 1;
+    ss->outputs[output].active_high = active_high;
+}
+DECL_COMMAND(command_config_scanner_sync_output,
+             "config_scanner_sync_output oid=%c output=%c pin=%u active_high=%c");
+
+void
+command_scanner_sync_start(uint32_t *args)
+{
+    uint8_t oid = args[0];
+    struct scanner_sync *ss = scanner_sync_oid_lookup(oid);
+    ss->next_frame_id = args[1];
+    ss->emitted_frame_count = 0;
+    ss->expected_frame_count = 1;
+    ss->active = 1;
+    if (!ss->hardware_outputs_enabled)
+        scanner_sync_emit_frame_event(oid, ss);
+}
+DECL_COMMAND(command_scanner_sync_start,
+             "scanner_sync_start oid=%c next_frame_id=%u");
+
+void
+command_scanner_sync_stop(uint32_t *args)
+{
+    uint8_t oid = args[0], reason = args[1];
+    struct scanner_sync *ss = scanner_sync_oid_lookup(oid);
+    if (ss->timer_active) {
+        sched_del_timer(&ss->timer);
+        ss->timer_active = 0;
+    }
+    scanner_sync_outputs_safe(ss);
+    ss->active = 0;
+    scanner_sync_emit_terminal(oid, ss, reason);
+}
+DECL_COMMAND(command_scanner_sync_stop,
+             "scanner_sync_stop oid=%c reason=%c");
+
+void
+command_scanner_sync_schedule_z(uint32_t *args)
+{
+    uint8_t oid = args[0];
+    uint32_t seq = args[1];
+    uint32_t stripe_id = args[2];
+    uint8_t target_kind = args[3];
+    int32_t target_value = args[4];
+    int32_t z_target_nm = args[5];
+    struct scanner_sync *ss = scanner_sync_oid_lookup(oid);
+
+    if (!ss->active || target_kind > 1 || !target_value || !z_target_nm) {
+        sendf("scanner_sync_z_rejected oid=%c seq=%u reason=%c status=%c",
+              oid, seq, 0, 1);
+        return;
+    }
+    sendf("scanner_sync_z_scheduled oid=%c seq=%u stripe_id=%u status=%c",
+          oid, seq, stripe_id, 0);
+    if (target_kind == 0 && target_value <= ss->next_frame_id) {
+        sendf("scanner_sync_z_applied oid=%c seq=%u frame_id=%u"
+              " z_cmd_count=%i status=%c",
+              oid, seq, ss->next_frame_id, z_target_nm, 0);
+    }
+}
+DECL_COMMAND(command_scanner_sync_schedule_z,
+             "scanner_sync_schedule_z oid=%c seq=%u stripe_id=%u"
+             " target_kind=%c target_value=%i z_target_nm=%i");
+
+void
+command_scanner_sync_arm_af_window(uint32_t *args)
+{
+    uint8_t oid = args[0];
+    uint32_t seq = args[1];
+    struct scanner_sync *ss = scanner_sync_oid_lookup(oid);
+    if (!ss->active || !ss->hardware_outputs_enabled) {
+        sendf("scanner_sync_z_rejected oid=%c seq=%u reason=%c status=%c",
+              oid, seq, 0, 1);
+    }
+}
+DECL_COMMAND(command_scanner_sync_arm_af_window,
+             "scanner_sync_arm_af_window oid=%c seq=%u stripe_id=%u frame_id=%u"
+             " stripe_frame_index=%u position_axis=%c trigger_position_count=%i"
+             " pattern_id=%u settle_us=%u xvs_trigger_pulse_us=%u"
+             " exposure_hold_us=%u");
+
+void
+command_scanner_sync_fire_af_window_now(uint32_t *args)
+{
+    uint8_t oid = args[0];
+    uint32_t seq = args[1];
+    struct scanner_sync *ss = scanner_sync_oid_lookup(oid);
+    if (!ss->active || !ss->hardware_outputs_enabled) {
+        sendf("scanner_sync_z_rejected oid=%c seq=%u reason=%c status=%c",
+              oid, seq, 0, 1);
+    }
+}
+DECL_COMMAND(command_scanner_sync_fire_af_window_now,
+             "scanner_sync_fire_af_window_now oid=%c seq=%u stripe_id=%u"
+             " frame_id=%u stripe_frame_index=%u position_axis=%c"
+             " event_position_count=%i pattern_id=%u settle_us=%u"
+             " xvs_trigger_pulse_us=%u exposure_hold_us=%u");
+
+void
+command_scanner_sync_run_stationary_af_test(uint32_t *args)
+{
+    uint8_t oid = args[0];
+    struct scanner_sync *ss = scanner_sync_oid_lookup(oid);
+    uint32_t frame_period_us = args[5];
+    uint32_t settle_us = args[9];
+    uint32_t xvs_pulse_us = args[10];
+    uint32_t exposure_hold_us = args[11];
+    if (!ss->hardware_outputs_enabled || !scanner_sync_outputs_ready(ss)
+        || ss->timer_active || !args[4] || !frame_period_us || !settle_us
+        || !xvs_pulse_us || !exposure_hold_us
+        || (args[6] != 'X' && args[6] != 'Y')
+        || xvs_pulse_us > exposure_hold_us
+        || settle_us + exposure_hold_us > frame_period_us) {
+        sendf("scanner_sync_z_rejected oid=%c seq=%u reason=%c status=%c",
+              oid, args[1], 0, 1);
+        return;
+    }
+
+    ss->seq = args[1];
+    ss->stripe_id = args[2];
+    ss->next_frame_id = args[3];
+    ss->emitted_frame_count = 0;
+    ss->expected_frame_count = args[4];
+    ss->frame_period_ticks = timer_from_us(frame_period_us);
+    ss->settle_ticks = timer_from_us(settle_us);
+    ss->xvs_pulse_ticks = timer_from_us(xvs_pulse_us);
+    ss->exposure_hold_ticks = timer_from_us(exposure_hold_us);
+    ss->position_axis = args[6];
+    ss->event_position_count = args[7];
+    ss->pattern_id = args[8];
+    ss->active = 1;
+
+    uint32_t now = timer_read_time();
+    ss->next_frame_clock = now + ss->settle_ticks;
+    scanner_sync_write_output(ss, SSO_TRIGGER, 0);
+    scanner_sync_write_output(ss, SSO_LED_WHITE, 0);
+    scanner_sync_write_output(ss, SSO_LED_RED, 1);
+    scanner_sync_write_output(ss, SSO_LED_GREEN, 1);
+    scanner_sync_schedule(ss, SSP_XVS_HIGH, ss->next_frame_clock);
+}
+DECL_COMMAND(command_scanner_sync_run_stationary_af_test,
+             "scanner_sync_run_stationary_af_test oid=%c seq=%u stripe_id=%u"
+             " first_frame_id=%u frame_count=%u frame_period_us=%u"
+             " position_axis=%c event_position_count=%i pattern_id=%u"
+             " settle_us=%u xvs_trigger_pulse_us=%u exposure_hold_us=%u");
+
+void
+scanner_sync_shutdown(void)
+{
+    uint8_t oid;
+    struct scanner_sync *ss;
+    foreach_oid(oid, ss, command_config_scanner_sync) {
+        if (ss->timer_active) {
+            sched_del_timer(&ss->timer);
+            ss->timer_active = 0;
+        }
+        scanner_sync_outputs_safe(ss);
+        ss->active = 0;
+    }
+}
+DECL_SHUTDOWN(scanner_sync_shutdown);
