diff --git a/klippy/extras/scanner_sync.py b/klippy/extras/scanner_sync.py
new file mode 100644
index 000000000..1c9b55f13
--- /dev/null
+++ b/klippy/extras/scanner_sync.py
@@ -0,0 +1,222 @@
+# Scanner synchronization host extra.
+#
+# Phase 3 stationary AF bench support. Hardware outputs are only accepted in
+# stationary_af_bench mode with explicit reviewed pins.
+
+class ScannerSync:
+    OUTPUT_TRIGGER = 0
+    OUTPUT_WHITE = 1
+    OUTPUT_RED = 2
+    OUTPUT_GREEN = 3
+
+    OUTPUT_CONFIG = (
+        ('xvs_trigger_pin', OUTPUT_TRIGGER),
+        ('led_white_pin', OUTPUT_WHITE),
+        ('led_red_pin', OUTPUT_RED),
+        ('led_green_pin', OUTPUT_GREEN),
+    )
+
+    VALID_MODES = ('metadata_only', 'stationary_af_bench')
+
+    def __init__(self, config):
+        self.printer = config.get_printer()
+        self.enabled = config.getboolean('enable', False)
+        self.protocol_version = config.getint('protocol_version', 1, minval=1,
+                                              maxval=1)
+        self.mode = config.get('mode', 'metadata_only')
+        self.hardware_outputs_enabled = config.getboolean(
+            'hardware_outputs_enabled', False)
+        if self.mode not in self.VALID_MODES:
+            raise config.error("unsupported scanner_sync mode '%s'" % self.mode)
+        if self.hardware_outputs_enabled and self.mode != 'stationary_af_bench':
+            raise config.error(
+                "scanner_sync hardware outputs require stationary_af_bench mode")
+        if self.mode == 'stationary_af_bench' and not self.hardware_outputs_enabled:
+            raise config.error(
+                "stationary_af_bench mode requires hardware_outputs_enabled")
+
+        self.status = 'disabled'
+        self.last_event = None
+        self.callback_events = []
+        self.commands = {}
+        self.output_pins = []
+        self.next_seq = 1
+        self.next_frame_id = 1
+        if not self.enabled:
+            return
+
+        self.mcu_name = config.get('mcu', 'mcu')
+        self.mcu = self.printer.lookup_object(self.mcu_name)
+        self.oid = self.mcu.create_oid()
+        self.cmd_queue = self.mcu.alloc_command_queue()
+        self._parse_output_pins(config)
+        self.mcu.register_config_callback(self._build_config)
+
+        gcode = self.printer.lookup_object('gcode')
+        gcode.register_command(
+            'SCANNER_SYNC_RUN_STATIONARY_AF_TEST',
+            self.cmd_SCANNER_SYNC_RUN_STATIONARY_AF_TEST,
+            desc='Run no-motion scanner AF LED/XVS timing bench sequence')
+        self.status = 'configured'
+
+    def _parse_output_pins(self, config):
+        if not self.hardware_outputs_enabled:
+            return
+        ppins = self.printer.lookup_object('pins')
+        for option_name, output_id in self.OUTPUT_CONFIG:
+            pin_desc = config.get(option_name, None)
+            if not pin_desc or pin_desc.lower() in ('none', 'unset'):
+                raise config.error(
+                    "scanner_sync requires %s in stationary_af_bench mode"
+                    % option_name)
+            pin_params = ppins.lookup_pin(pin_desc, can_invert=True)
+            if pin_params['chip_name'] != self.mcu_name:
+                raise config.error(
+                    "%s must be on scanner_sync mcu '%s'"
+                    % (option_name, self.mcu_name))
+            active_high = 0 if pin_params['invert'] else 1
+            self.output_pins.append((output_id, pin_params['pin'], active_high))
+
+    def _build_config(self):
+        self.mcu.add_config_cmd(
+            "config_scanner_sync oid=%d protocol_version=%d"
+            " hardware_outputs_enabled=%d"
+            % (self.oid, self.protocol_version,
+               1 if self.hardware_outputs_enabled else 0), is_init=True)
+        for output_id, pin, active_high in self.output_pins:
+            self.mcu.add_config_cmd(
+                "config_scanner_sync_output oid=%d output=%d pin=%s"
+                " active_high=%d"
+                % (self.oid, output_id, pin, active_high), is_init=True)
+
+        self.commands['start'] = self.mcu.lookup_command(
+            "scanner_sync_start oid=%c next_frame_id=%u", cq=self.cmd_queue)
+        self.commands['stop'] = self.mcu.lookup_command(
+            "scanner_sync_stop oid=%c reason=%c", cq=self.cmd_queue)
+        self.commands['schedule_z'] = self.mcu.lookup_command(
+            "scanner_sync_schedule_z oid=%c seq=%u stripe_id=%u"
+            " target_kind=%c target_value=%i z_target_nm=%i",
+            cq=self.cmd_queue)
+        self.commands['arm_af_window'] = self.mcu.lookup_command(
+            "scanner_sync_arm_af_window oid=%c seq=%u stripe_id=%u frame_id=%u"
+            " stripe_frame_index=%u position_axis=%c trigger_position_count=%i"
+            " pattern_id=%u settle_us=%u xvs_trigger_pulse_us=%u"
+            " exposure_hold_us=%u", cq=self.cmd_queue)
+        self.commands['fire_af_window_now'] = self.mcu.lookup_command(
+            "scanner_sync_fire_af_window_now oid=%c seq=%u stripe_id=%u"
+            " frame_id=%u stripe_frame_index=%u position_axis=%c"
+            " event_position_count=%i pattern_id=%u settle_us=%u"
+            " xvs_trigger_pulse_us=%u exposure_hold_us=%u", cq=self.cmd_queue)
+        self.commands['run_stationary_af_test'] = self.mcu.lookup_command(
+            "scanner_sync_run_stationary_af_test oid=%c seq=%u stripe_id=%u"
+            " first_frame_id=%u frame_count=%u frame_period_us=%u"
+            " position_axis=%c event_position_count=%i pattern_id=%u"
+            " settle_us=%u xvs_trigger_pulse_us=%u exposure_hold_us=%u",
+            cq=self.cmd_queue)
+
+        self.mcu.register_serial_response(
+            self._handle_frame_event,
+            "scanner_sync_frame_event oid=%c frame_id=%u stripe_id=%u"
+            " stripe_frame_index=%u pattern_id=%u position_axis=%c"
+            " event_position=%i x_count=%i y_count=%i z_count=%i"
+            " mcu_time_us=%u status=%c flags=%u", self.oid)
+        self.mcu.register_serial_response(
+            self._handle_scheduler_terminal,
+            "scanner_sync_scheduler_terminal oid=%c stripe_id=%u status=%c"
+            " reason=%c emitted_frame_count=%u expected_frame_count=%u"
+            " last_frame_id=%i next_frame_id=%u next_stripe_frame_index=%u"
+            " mcu_time_us=%u", self.oid)
+        self.mcu.register_serial_response(
+            self._handle_z_scheduled,
+            "scanner_sync_z_scheduled oid=%c seq=%u stripe_id=%u status=%c",
+            self.oid)
+        self.mcu.register_serial_response(
+            self._handle_z_applied,
+            "scanner_sync_z_applied oid=%c seq=%u frame_id=%u"
+            " z_cmd_count=%i status=%c", self.oid)
+        self.mcu.register_serial_response(
+            self._handle_z_rejected,
+            "scanner_sync_z_rejected oid=%c seq=%u reason=%c status=%c",
+            self.oid)
+
+    def _require_stationary_af_bench(self, gcmd):
+        if self.mode != 'stationary_af_bench' or not self.hardware_outputs_enabled:
+            raise gcmd.error(
+                "SCANNER_SYNC_RUN_STATIONARY_AF_TEST requires"
+                " stationary_af_bench mode with hardware outputs enabled")
+        if 'run_stationary_af_test' not in self.commands:
+            raise gcmd.error("scanner_sync MCU command is not ready")
+
+    def cmd_SCANNER_SYNC_RUN_STATIONARY_AF_TEST(self, gcmd):
+        self._require_stationary_af_bench(gcmd)
+        seq = gcmd.get_int('SEQ', self.next_seq, minval=1)
+        stripe_id = gcmd.get_int('STRIPE_ID', 0, minval=0)
+        first_frame_id = gcmd.get_int('FIRST_FRAME_ID', self.next_frame_id,
+                                      minval=1)
+        frame_count = gcmd.get_int('FRAME_COUNT', 10, minval=1, maxval=10000)
+        frame_period_us = gcmd.get_int('FRAME_PERIOD_US', 100000, minval=1)
+        position_axis = gcmd.get('POSITION_AXIS', 'X').upper()
+        if position_axis not in ('X', 'Y'):
+            raise gcmd.error("POSITION_AXIS must be X or Y")
+        event_position_count = gcmd.get_int('EVENT_POSITION_COUNT', 0)
+        pattern_id = gcmd.get_int('PATTERN_ID', 1, minval=0, maxval=255)
+        settle_us = gcmd.get_int('SETTLE_US', 1000, minval=1)
+        xvs_trigger_pulse_us = gcmd.get_int('XVS_TRIGGER_PULSE_US', 200,
+                                            minval=1)
+        exposure_hold_us = gcmd.get_int('EXPOSURE_HOLD_US', 4000, minval=1)
+        if xvs_trigger_pulse_us > exposure_hold_us:
+            raise gcmd.error("XVS_TRIGGER_PULSE_US must be <= EXPOSURE_HOLD_US")
+        if settle_us + exposure_hold_us > frame_period_us:
+            raise gcmd.error(
+                "SETTLE_US + EXPOSURE_HOLD_US must be <= FRAME_PERIOD_US")
+
+        self.commands['run_stationary_af_test'].send(
+            [self.oid, seq, stripe_id, first_frame_id, frame_count,
+             frame_period_us, ord(position_axis), event_position_count,
+             pattern_id, settle_us, xvs_trigger_pulse_us, exposure_hold_us],
+            minclock=0, reqclock=0)
+        self.next_seq = max(self.next_seq, seq + 1)
+        self.next_frame_id = max(self.next_frame_id,
+                                 first_frame_id + frame_count)
+        self.status = 'stationary_af_test_running'
+        gcmd.respond_info(
+            "scanner_sync stationary AF test queued: seq=%d frames=%d"
+            " period_us=%d settle_us=%d xvs_us=%d exposure_hold_us=%d"
+            % (seq, frame_count, frame_period_us, settle_us,
+               xvs_trigger_pulse_us, exposure_hold_us))
+
+    def _record_event(self, event_type, params):
+        event = dict(params)
+        event['type'] = event_type
+        self.last_event = event
+        self.callback_events.append(event)
+
+    def _handle_frame_event(self, params):
+        self._record_event('FRAME_EVENT', params)
+
+    def _handle_scheduler_terminal(self, params):
+        self.status = 'terminal'
+        self._record_event('SCHEDULER_TERMINAL', params)
+
+    def _handle_z_scheduled(self, params):
+        self._record_event('Z_SCHEDULED', params)
+
+    def _handle_z_applied(self, params):
+        self._record_event('Z_APPLIED', params)
+
+    def _handle_z_rejected(self, params):
+        self._record_event('Z_REJECTED', params)
+
+    def get_status(self, eventtime):
+        return {
+            'enabled': self.enabled,
+            'mode': self.mode,
+            'hardware_outputs_enabled': self.hardware_outputs_enabled,
+            'status': self.status,
+            'last_event': self.last_event,
+            'callback_events': list(self.callback_events),
+        }
+
+
+def load_config(config):
+    return ScannerSync(config)
