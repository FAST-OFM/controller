{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fast-ofm.example/schema/led-pwm-current-map-v1.json",
  "title": "Fast OFM LED PWM-to-current calibration map",
  "type": "object",
  "required": ["schema_version", "artifact_version", "channel", "points"],
  "properties": {
    "schema_version": { "const": 1 },
    "artifact_version": { "type": "integer", "minimum": 1 },
    "channel": { "enum": ["RED", "GREEN", "WHITE_BF"] },
    "points": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["pwm", "current_ma_x100"],
        "properties": {
          "pwm": { "type": "integer", "minimum": 0, "maximum": 255 },
          "current_ma_x100": { "type": "integer", "minimum": 0, "maximum": 65535 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "description": "Review-only measurement artifact. The firmware v6 storage accepts exactly two strictly increasing points; a future reviewed arming path must validate target reachability before deriving PWM."
}
